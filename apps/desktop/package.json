{
  "name": "@coding-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.18",
    "@ai-sdk/react": "4.0.47",
    "@alibaba-group/open-code-review": "1.8.0",
    "@coding-agent/core": "0.1.0",
    "@coding-agent/integrations": "0.1.0",
    "@coding-agent/pi-package": "0.1.0",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@qoder-ai/qoder-agent-sdk": "1.0.16",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@rive-app/react-webgl2": "4.30.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@xyflow/react": "12.11.2",
    "ai": "7.0.44",
    "ansi-to-react": "6.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "^0.468.0",
    "media-chrome": "4.19.2",
    "motion": "12.43.0",
    "nanoid": "6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-jsx-parser": "2.4.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.1.5",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.1",
    "sonner": "2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tokenlens": "1.3.1",
    "use-stick-to-bottom": "1.1.6",
    "zod": "^3.24.2"
  },
  "build": {
    "appId": "com.codingagent.desktop",
    "productName": "Coding Agent",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "37.10.3",
    "electron-builder": "^25.1.8",
    "jsdom": "30.0.1",
    "vite": "^6.0.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  }
}
