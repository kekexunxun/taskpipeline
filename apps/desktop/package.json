{
  "name": "@task-pipeline/desktop",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kekexunxun/taskpipeline.git",
    "directory": "apps/desktop"
  },
  "scripts": {
    "predev": "node scripts/sync-icon.mjs && node scripts/patch-dev-app-name.mjs && node scripts/copy-qodercli.mjs && npm run build -w @task-pipeline/core && npm run build -w @task-pipeline/integrations && npm run build -w @task-pipeline/pi-package",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "prebuild": "node scripts/sync-icon.mjs",
    "prepackage": "node scripts/sync-icon.mjs && node scripts/copy-monorepo-packages.mjs && node scripts/copy-qodercli.mjs",
    "prepackage:dir": "node scripts/sync-icon.mjs && node scripts/copy-monorepo-packages.mjs && node scripts/copy-qodercli.mjs",
    "prepackage:mac": "node scripts/sync-icon.mjs && node scripts/copy-monorepo-packages.mjs && node scripts/copy-qodercli.mjs",
    "prepackage:win": "node scripts/sync-icon.mjs && node scripts/copy-monorepo-packages.mjs && node scripts/copy-qodercli.mjs",
    "prepackage:linux": "node scripts/sync-icon.mjs && node scripts/copy-monorepo-packages.mjs && node scripts/copy-qodercli.mjs",
    "stage:monorepo": "node scripts/copy-monorepo-packages.mjs",
    "package": "electron-builder && node scripts/sync-local-install.mjs",
    "package:dir": "electron-builder --dir && node scripts/sync-local-install.mjs",
    "package:mac": "electron-builder --mac && node scripts/sync-local-install.mjs",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.taskpipeline.desktop",
    "productName": "TaskPipeline",
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "icon": "build/icon.normalized.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "qoder-bin/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**",
      "**/@qoder-ai/qoder-agent-sdk/**",
      "**/qoder-bin/**",
      "**/@alibaba-group/ocr-darwin-arm64/**",
      "**/@alibaba-group/ocr-darwin-x64/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.28",
    "@ai-sdk/openai": "4.0.42",
    "@ai-sdk/openai-compatible": "3.0.31",
    "@alibaba-group/open-code-review": "1.9.5",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@qoder-ai/qoder-agent-sdk": "1.0.23",
    "@task-pipeline/core": "*",
    "@task-pipeline/integrations": "*",
    "@task-pipeline/pi-package": "*",
    "ai": "7.0.66",
    "electron-updater": "6.8.9",
    "extract-zip": "2.0.1",
    "turndown": "7.2.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.69",
    "@electron/rebuild": "4.2.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@rive-app/react-webgl2": "4.30.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "12.11.2",
    "ansi-to-react": "6.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "37.10.3",
    "electron-builder": "^25.1.8",
    "embla-carousel-react": "8.6.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.31.0",
    "media-chrome": "4.19.2",
    "motion": "12.43.0",
    "nanoid": "6.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-jsx-parser": "2.4.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tokenlens": "1.3.1",
    "use-stick-to-bottom": "1.1.6",
    "vite": "7.3.6",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  },
  "optionalDependencies": {
    "@alibaba-group/ocr-darwin-x64": "1.9.5",
    "@alibaba-group/ocr-win32-x64": "1.9.5",
    "@esbuild/win32-x64": "0.28.2",
    "@rollup/rollup-win32-x64-msvc": "4.62.4",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-win32-x64-msvc": "1.33.0"
  }
}
