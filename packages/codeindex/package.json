{
  "name": "@task-pipeline/codeindex",
  "version": "0.1.0",
  "description": "mini-Atlas — 纯自研、真实仓库零侵入的源码索引引擎（web-tree-sitter + SQLite/FTS5）",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node-watcher": {
      "types": "./dist/runtime/node-watcher.d.ts",
      "default": "./dist/runtime/node-watcher.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.13",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.1",
    "ignore": "^5.3.2",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "vitest": "^3.2.4"
  }
}
